{{ 'home.css' | asset_url | stylesheet_tag }}

<div
  class="section {% if section.settings.background == 'warm' %}section--warm{% endif %}"
  style="--section-padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="editorial-header">
        <h2 class="editorial-header__title" data-reveal>{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="collection-list">
      {%- for block in section.blocks -%}
        {%- assign block_collection = block.settings.collection -%}
        <a
          class="collection-list__card {% if settings.animations_image_zoom %}media-zoom{% endif %}"
          href="{{ block_collection.url | default: routes.all_products_collection_url }}"
          data-reveal
          style="--reveal-delay: {{ forloop.index0 | times: 60 }}ms;"
          {{ block.shopify_attributes }}
        >
          <div class="collection-list__media">
            {%- liquid
              assign block_image = block.settings.image
              if block_image == blank
                assign block_image = block_collection.featured_image
              endif
            -%}
            {%- if block_image != blank -%}
              {{
                block_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 500, 700, 900, 1200',
                  sizes: '(min-width: 990px) 30vw, 90vw',
                  alt: block_image.alt
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <span class="collection-list__title h3">
            {%- if block.settings.title != blank -%}
              {{ block.settings.title | escape }}
            {%- elsif block_collection.title != blank -%}
              {{ block_collection.title | escape }}
            {%- else -%}
              {{ 'onboarding.collection_title' | t }}
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Lista de colecciones",
  "tag": "section",
  "class": "section-collection-list",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Colecciones"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fondo",
      "options": [
        { "value": "default", "label": "Blanco" },
        { "value": "warm", "label": "Blanco cálido" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título personalizado"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen personalizada"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lista de colecciones",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
