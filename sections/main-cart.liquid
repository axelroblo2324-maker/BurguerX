{%- comment -%}
  Página de carrito. El checkout siempre es el nativo y protegido de Shopify.
{%- endcomment -%}

<div
  class="section"
  style="--section-padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="content-header content-header--split">
      <h1 class="h1">{{ 'sections.cart.title' | t }}</h1>
      {%- unless cart == empty -%}
        <span class="eyebrow">{{ 'sections.cart.cart_count' | t: count: cart.item_count }}</span>
      {%- endunless -%}
    </div>

    {%- if cart == empty -%}
      <div class="empty-state">
        <p class="h2">{{ 'sections.cart.empty' | t }}</p>
        <p class="text-small text-muted">{{ 'sections.cart.empty_subtext' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button button--compact">
          {{ 'sections.cart.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}
      <div class="main-cart">
        <div class="main-cart__items">
          {% render 'cart-items', context: 'page' %}
        </div>

        <aside class="main-cart__summary">
          {%- if settings.cart_free_shipping_enabled -%}
            {% render 'free-shipping-bar' %}
          {%- endif -%}

          {%- if settings.cart_show_note -%}
            <div class="field" style="margin-bottom: 1.25rem;">
              <label class="field__label" for="CartPageNote">{{ 'sections.cart.note' | t }}</label>
              <textarea
                id="CartPageNote"
                class="field__input"
                name="note"
                rows="3"
                data-cart-note
                placeholder="{{ 'sections.cart.note_placeholder' | t | escape }}"
              >{{ cart.note }}</textarea>
            </div>
          {%- endif -%}

          <div class="cart-drawer__totals">
            <span class="cart-drawer__totals-label">{{ 'sections.cart.subtotal' | t }}</span>
            <span class="cart-drawer__totals-value">{{ cart.total_price | money_with_currency }}</span>
          </div>

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul>
              {%- for discount in cart.cart_level_discount_applications -%}
                <li class="cart-item__discount">
                  {{ discount.title }} (&minus;{{ discount.total_allocated_amount | money }})
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <p class="cart-drawer__tax">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>

          <form action="{{ routes.cart_url }}" method="post" id="CartPageForm">
            <button type="submit" name="checkout" class="button button--full">
              {{ 'sections.cart.checkout' | t }}
            </button>
          </form>

          <div style="margin-top: 1rem;">
            <a href="{{ routes.all_products_collection_url }}" class="link-underline">
              {{ 'sections.cart.continue_shopping' | t }}
            </a>
          </div>
        </aside>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .main-cart {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .main-cart__summary {
    align-self: start;
  }

  @media screen and (min-width: 990px) {
    .main-cart {
      grid-template-columns: minmax(0, 1.7fr) minmax(300px, 0.9fr);
    }

    .main-cart__summary {
      position: sticky;
      top: calc(var(--header-height) + 28px);
      border-left: 1px solid var(--color-border);
      padding-left: clamp(1.5rem, 3vw, 2.5rem);
    }
  }
</style>

{% schema %}
{
  "name": "Carrito",
  "tag": "section",
  "class": "section-main-cart",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    }
  ]
}
{% endschema %}
