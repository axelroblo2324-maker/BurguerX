{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign show_image = false
  if section.settings.show_collection_image and collection.image
    assign show_image = true
  endif
-%}

<div class="page-width">
  <div class="collection-hero {% if show_image %}collection-hero--image{% endif %}">
    {%- if show_image -%}
      <div class="collection-hero__media">
        {{
          collection.image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '600, 900, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            alt: collection.image.alt
        }}
      </div>
    {%- endif -%}

    {%- if section.settings.show_breadcrumbs and show_image == false -%}
      <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ collection.title | escape }}</span>
      </nav>
    {%- endif -%}

    <h1 class="collection-hero__title" data-reveal>{{ collection.title | escape }}</h1>

    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="collection-hero__description rte" data-reveal style="--reveal-delay: 80ms;">
        {{ collection.description }}
      </div>
    {%- endif -%}

    {%- if section.settings.show_product_count -%}
      <p class="collection-hero__meta">
        {{- 'products.facets.product_count_simple' | t: count: collection.products_count -}}
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Encabezado de colección",
  "tag": "section",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Usar la imagen de la colección como portada",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Mostrar la descripción",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Mostrar el número de productos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Mostrar ruta de navegación",
      "default": true
    }
  ]
}
{% endschema %}
