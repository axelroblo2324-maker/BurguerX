{%- comment -%}
  Selector de variantes con swatches de color y botones de talla.
  Parámetros: product, section_id, product_form_id, size_chart_id, update_url
{%- endcomment -%}

{%- liquid
  assign color_names = settings.card_color_option_names | downcase | split: ','
  assign size_names = settings.card_size_option_names | downcase | split: ','
-%}

{%- unless product.has_only_default_variant -%}
  <variant-picker
    class="variant-picker"
    data-section="{{ section_id }}"
    data-url="{{ product.url }}"
    data-update-url="{{ update_url | default: true }}"
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_index = forloop.index0
        assign option_name = option.name | downcase | strip

        assign is_color = false
        for candidate in color_names
          assign candidate_name = candidate | strip
          if option_name == candidate_name
            assign is_color = true
            break
          endif
        endfor

        assign is_size = false
        for candidate in size_names
          assign candidate_name = candidate | strip
          if option_name == candidate_name
            assign is_size = true
            break
          endif
        endfor

        assign use_select = false
        if option.values.size > 14 and is_color == false
          assign use_select = true
        endif
      -%}

      {%- comment -%}
        Shopify entrega las tallas en el orden en que se capturaron, que suele
        ser alfabético: L, M, S, XL. Aquí se reordenan a la escala real. A cada
        valor se le antepone un rango de cuatro cifras y se ordena por texto:
        con cuatro cifras fijas ese orden coincide con el numérico.
          1000-1090  tallas de letra, de XXXS a XXXXL
          2001-2999  tallas numéricas (28, 30, 32…), por su número
          9000-9999  cualquier otra cosa, en el orden original
      {%- endcomment -%}
      {%- liquid
        assign option_values = option.values

        if is_size and option.values.size > 1
          assign size_scale = 'XXXS,XXS,XS,S,M,L,XL,XXL,XXXL,XXXXL' | split: ','
          assign keyed = ''

          for value in option.values
            assign position = forloop.index0
            assign token = value | upcase | strip | replace: ' ', '' | replace: '-', ''
            assign rank = 9000 | plus: position

            for step in size_scale
              if token == step
                assign rank = forloop.index0 | times: 10 | plus: 1000
                break
              endif
            endfor

            if rank >= 9000
              assign numeric = token | plus: 0
              if numeric > 0 and numeric < 1000
                assign rank = numeric | plus: 2000
              endif
            endif

            assign keyed = keyed | append: rank | append: '|' | append: value | append: '~~'
          endfor

          assign ordered = ''
          assign sorted_keys = keyed | split: '~~' | sort

          for entry in sorted_keys
            assign entry_value = entry | slice: 5, 250
            assign ordered = ordered | append: entry_value | append: '~~'
          endfor

          comment
            Sólo se adopta el orden nuevo si conserva todas las tallas. Si algo
            saliera mal se muestra el orden original: una talla de menos en el
            selector es una venta perdida, un orden raro no.
          endcomment
          assign reordered = ordered | split: '~~'
          if reordered.size == option.values.size
            assign option_values = reordered
          endif
        endif
      -%}

      <fieldset
        class="variant-option {% if is_color %}variant-option--swatch{% endif %}"
        data-option-index="{{ option_index }}"
      >
        <div class="variant-option__header">
          <legend class="variant-option__label">{{ option.name | escape }}</legend>
          <span class="variant-option__value" data-option-selected="{{ option_index }}">
            {{- option.selected_value | escape -}}
          </span>
        </div>

        {%- if use_select -%}
          <select
            class="variant-option__select"
            id="Option-{{ section_id }}-{{ option_index }}"
            name="options[{{ option.name | escape }}]"
            aria-label="{{ option.name | escape }}"
          >
            {%- for value in option_values -%}
              <option
                value="{{ value | escape }}"
                {% if value == option.selected_value %}selected{% endif %}
              >
                {{ value }}
              </option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <div class="variant-option__list">
            {%- for value in option_values -%}
              {%- liquid
                assign input_id = 'Option-' | append: section_id | append: '-' | append: option_index | append: '-' | append: forloop.index0
                assign swatch_style = ''
                if is_color
                  if value.swatch.image
                    assign swatch_url = value.swatch.image | image_url: width: 80
                    assign swatch_style = 'background-image: url(' | append: swatch_url | append: ');'
                  elsif value.swatch.color
                    assign swatch_style = 'background-color: ' | append: value.swatch.color | append: ';'
                  else
                    assign fallback_color = value | downcase | replace: ' ', ''
                    assign swatch_style = 'background-color: ' | append: fallback_color | append: ';'
                  endif
                endif
              -%}
              <input
                type="radio"
                class="variant-option__input"
                id="{{ input_id }}"
                name="{{ option.name | escape }}-{{ section_id }}"
                value="{{ value | escape }}"
                {% if value == option.selected_value %}checked{% endif %}
              >
              <label
                class="variant-option__button"
                for="{{ input_id }}"
                {% if is_color %}
                  style="{{ swatch_style }}"
                  title="{{ value | escape }}"
                {% endif %}
              >
                {%- if is_color -%}
                  <span class="visually-hidden">{{ value }}</span>
                {%- else -%}
                  {{ value }}
                {%- endif -%}
              </label>
            {%- endfor -%}
          </div>

          {%- if is_size and size_chart_id != blank -%}
            <button
              type="button"
              class="product__size-chart-trigger"
              data-modal-trigger="{{ size_chart_id }}"
              style="justify-self: start; margin-top: 0.25rem;"
            >
              {{ 'products.product.size_chart' | t }}
            </button>
          {%- endif -%}
        {%- endif -%}
      </fieldset>
    {%- endfor -%}

    <script type="application/json" data-variant-json>
      [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "available": {{ variant.available }},
            "options": {{ variant.options | json }},
            "featured_media": {% if variant.featured_media %}{ "id": {{ variant.featured_media.id }} }{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    </script>
  </variant-picker>

{%- endunless -%}
