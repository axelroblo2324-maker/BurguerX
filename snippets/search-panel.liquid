{%- liquid
  assign types = 'product'
  if settings.search_show_collections
    assign types = types | append: ',collection'
  endif
  if settings.search_show_pages
    assign types = types | append: ',page,article'
  endif
-%}

<search-panel
  id="SearchPanel"
  class="search-panel"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'general.search.heading' | t }}"
  aria-hidden="true"
  data-search-types="{{ types }}"
  {% if settings.search_predictive_enabled %}data-predictive{% endif %}
  hidden
>
  <div class="search-panel__bar">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-panel__form">
      <label class="visually-hidden" for="SearchPanelInput">{{ 'general.search.heading' | t }}</label>
      {% render 'icon', icon: 'search', size: 20 %}
      <input
        id="SearchPanelInput"
        class="search-panel__input"
        type="search"
        name="q"
        autocomplete="off"
        spellcheck="false"
        placeholder="{{ 'general.search.placeholder' | t | escape }}"
        data-search-input
        data-panel-focus
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="visually-hidden">{{ 'general.search.submit' | t }}</button>
    </form>

    <button type="button" class="icon-button" data-search-reset aria-label="{{ 'general.search.reset' | t }}">
      {% render 'icon', icon: 'close', size: 16 %}
    </button>

    <button type="button" class="link-underline" data-panel-close>
      {{ 'general.search.close' | t }}
    </button>
  </div>

  <div class="search-panel__results" data-search-results aria-live="polite"></div>
</search-panel>
