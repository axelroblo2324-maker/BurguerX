{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "vendor",
          "settings": {
            "placement": "info"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "placement": "info"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "placement": "info"
          }
        },
        "price": {
          "type": "price",
          "settings": {
            "show_tax_note": true,
            "placement": "purchase"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "placement": "purchase"
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "low_stock_threshold": 8,
            "placement": "purchase"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity": true,
            "show_dynamic_checkout": true,
            "placement": "purchase"
          }
        },
        "sku": {
          "type": "sku",
          "settings": {
            "placement": "purchase"
          }
        },
        "description": {
          "type": "description",
          "settings": {
            "heading": "Descripción",
            "open_by_default": true,
            "placement": "extras"
          }
        },
        "materials": {
          "type": "accordion",
          "settings": {
            "heading": "Materiales",
            "content": "<p>Describe aquí la composición de la tela y el origen de los materiales.</p>",
            "open_by_default": false,
            "placement": "extras"
          }
        },
        "care": {
          "type": "accordion",
          "settings": {
            "heading": "Cuidados",
            "content": "<p>Lavar a máquina en frío con colores similares. No usar blanqueador. Secar a la sombra.</p>",
            "open_by_default": false,
            "placement": "extras"
          }
        },
        "shipping": {
          "type": "accordion",
          "settings": {
            "heading": "Envíos y devoluciones",
            "content": "<p>Envíos a todo México en 3 a 6 días hábiles. Cambios dentro de los primeros 30 días.</p>",
            "open_by_default": false,
            "placement": "extras"
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "placement": "extras"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "text",
        "price",
        "variant_picker",
        "inventory",
        "buy_buttons",
        "sku",
        "description",
        "materials",
        "care",
        "shipping",
        "share"
      ],
      "settings": {
        "gallery_style": "editorial",
        "media_width": 2.4,
        "enable_sticky_buy": true,
        "show_breadcrumbs": true,
        "padding_top": 48,
        "padding_bottom": 100
      }
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": {
        "heading": "También te puede gustar",
        "products_to_show": 4,
        "padding_top": 100,
        "padding_bottom": 112
      }
    }
  },
  "order": [
    "main",
    "recommendations"
  ]
}
