{%- if cart != empty and cart.item_count > 0 -%}
  <span class="header__cart-count" aria-hidden="true">
    {{- cart.item_count | at_most: 99 -}}
  </span>
  <span class="visually-hidden">
    {{- 'sections.header.cart_count' | t: count: cart.item_count -}}
  </span>
{%- else -%}
  <span class="header__cart-count" hidden></span>
{%- endif -%}
