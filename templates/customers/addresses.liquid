<div class="page-width">
  <div class="customer customer--wide">
    <div class="content-header content-header--split">
      <h1 class="h2">{{ 'customer.addresses.title' | t }}</h1>
      <a href="{{ routes.account_url }}" class="link-underline">{{ 'customer.account.return' | t }}</a>
    </div>

    <details style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
      <summary class="accordion__summary">
        <span>{{ 'customer.addresses.add_new' | t }}</span>
        <span class="accordion__icon" aria-hidden="true"></span>
      </summary>
      <div style="padding-bottom: 1.5rem;">
        {%- form 'customer_address', customer.new_address -%}
          <div style="display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
            <div class="field">
              <label class="field__label" for="AddressFirstNameNew">{{ 'customer.addresses.first_name' | t }}</label>
              <input class="field__input" id="AddressFirstNameNew" type="text" name="address[first_name]" autocomplete="given-name">
            </div>
            <div class="field">
              <label class="field__label" for="AddressLastNameNew">{{ 'customer.addresses.last_name' | t }}</label>
              <input class="field__input" id="AddressLastNameNew" type="text" name="address[last_name]" autocomplete="family-name">
            </div>
            <div class="field">
              <label class="field__label" for="AddressCompanyNew">{{ 'customer.addresses.company' | t }}</label>
              <input class="field__input" id="AddressCompanyNew" type="text" name="address[company]" autocomplete="organization">
            </div>
            <div class="field">
              <label class="field__label" for="AddressPhoneNew">{{ 'customer.addresses.phone' | t }}</label>
              <input class="field__input" id="AddressPhoneNew" type="tel" name="address[phone]" autocomplete="tel">
            </div>
            <div class="field">
              <label class="field__label" for="AddressAddress1New">{{ 'customer.addresses.address1' | t }}</label>
              <input class="field__input" id="AddressAddress1New" type="text" name="address[address1]" autocomplete="address-line1">
            </div>
            <div class="field">
              <label class="field__label" for="AddressAddress2New">{{ 'customer.addresses.address2' | t }}</label>
              <input class="field__input" id="AddressAddress2New" type="text" name="address[address2]" autocomplete="address-line2">
            </div>
            <div class="field">
              <label class="field__label" for="AddressCityNew">{{ 'customer.addresses.city' | t }}</label>
              <input class="field__input" id="AddressCityNew" type="text" name="address[city]" autocomplete="address-level2">
            </div>
            <div class="field">
              <label class="field__label" for="AddressZipNew">{{ 'customer.addresses.zip' | t }}</label>
              <input class="field__input" id="AddressZipNew" type="text" name="address[zip]" autocomplete="postal-code">
            </div>
            <div class="field">
              <label class="field__label" for="AddressCountryNew">{{ 'customer.addresses.country' | t }}</label>
              <select class="field__input" id="AddressCountryNew" name="address[country]" data-default="{{ form.country }}" autocomplete="country">
                {{ country_option_tags }}
              </select>
            </div>
            <div class="field">
              <label class="field__label" for="AddressProvinceNew">{{ 'customer.addresses.province' | t }}</label>
              <input class="field__input" id="AddressProvinceNew" type="text" name="address[province]" autocomplete="address-level1">
            </div>
          </div>

          <label class="facet-option" style="margin-top: 1.25rem;">
            {{ form.set_as_default_checkbox }}
            <span>{{ 'customer.addresses.set_default' | t }}</span>
          </label>

          <button type="submit" class="button button--compact" style="margin-top: 1.25rem; justify-self: start;">
            {{ 'customer.addresses.add' | t }}
          </button>
        {%- endform -%}
      </div>
    </details>

    {%- paginate customer.addresses by 10 -%}
      <div style="display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); margin-top: 2rem;">
        {%- for address in customer.addresses -%}
          <div style="border: 1px solid var(--color-border); padding: 1.25rem;">
            {%- if address == customer.default_address -%}
              <p class="eyebrow">{{ 'customer.addresses.default' | t }}</p>
            {%- endif -%}
            <div class="text-small" style="margin-top: 0.5rem;">{{ address | format_address }}</div>

            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
              <a href="{{ routes.account_addresses_url }}" class="link-underline">
                {{ 'customer.addresses.edit' | t }}
              </a>
              <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}">
                <input type="hidden" name="_method" value="delete">
                <button type="submit" class="link-underline">{{ 'customer.addresses.delete' | t }}</button>
              </form>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</div>
