{{ 'home.css' | asset_url | stylesheet_tag }}

<div
  class="section {% if section.settings.background == 'warm' %}section--warm{% endif %}"
  style="--section-padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="image-with-text {% if section.settings.reverse %}image-with-text--reverse{% endif %}">
      <div class="image-with-text__media" data-reveal>
        <div class="media media--{{ section.settings.image_ratio }} {% if settings.animations_image_zoom %}media-zoom{% endif %}">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1800
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1100, 1500, 1800',
                sizes: '(min-width: 750px) 48vw, 100vw',
                alt: section.settings.image.alt
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

      <div class="image-with-text__content" data-reveal style="--reveal-delay: 100ms;">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h1">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div>
            <a
              href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
              class="button button--compact button--outline"
            >
              {{ section.settings.button_label | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Imagen con texto",
  "tag": "section",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de imagen",
      "options": [
        { "value": "portrait", "label": "Vertical 3:4" },
        { "value": "tall", "label": "Vertical alta 2:3" },
        { "value": "square", "label": "Cuadrada 1:1" },
        { "value": "landscape", "label": "Horizontal 4:3" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Invertir imagen y texto",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta pequeña"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Hecho con intención"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Telas seleccionadas, patrones propios y una producción corta que evita el exceso.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fondo",
      "options": [
        { "value": "default", "label": "Blanco" },
        { "value": "warm", "label": "Blanco cálido" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "presets": [
    {
      "name": "Imagen con texto"
    }
  ]
}
{% endschema %}
