<div
  class="section"
  style="--section-padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <div class="content-header">
        <h2 class="h2" data-reveal>{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    {%- form 'contact', class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-status">{{ 'general.newsletter_form.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div style="display: grid; gap: 1.5rem;">
        <div style="display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
          <div class="field">
            <label class="field__label" for="ContactName">{{ 'customer.register.first_name' | t }}</label>
            <input
              class="field__input"
              id="ContactName"
              type="text"
              name="contact[{{ 'customer.register.first_name' | t }}]"
              autocomplete="name"
            >
          </div>
          <div class="field">
            <label class="field__label" for="ContactEmail">{{ 'customer.register.email' | t }}</label>
            <input
              class="field__input"
              id="ContactEmail"
              type="email"
              name="contact[email]"
              autocomplete="email"
              required
            >
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="ContactPhone">{{ 'customer.addresses.phone' | t }}</label>
          <input
            class="field__input"
            id="ContactPhone"
            type="tel"
            name="contact[{{ 'customer.addresses.phone' | t }}]"
            autocomplete="tel"
          >
        </div>

        <div class="field">
          <label class="field__label" for="ContactBody">{{ section.settings.message_label | escape }}</label>
          <textarea class="field__input" id="ContactBody" name="contact[body]" rows="6" required></textarea>
        </div>

        <button type="submit" class="button button--compact" style="justify-self: start;">
          {{ section.settings.button_label | escape }}
        </button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Formulario de contacto",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Escríbenos"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Etiqueta del mensaje",
      "default": "Mensaje"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Enviar"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "Formulario de contacto"
    }
  ]
}
{% endschema %}
