{%- liquid
  assign wordmark = section.settings.wordmark_text | default: shop.name
  assign wordmark_length = wordmark | size | at_least: 1
  assign wordmark_divisor = wordmark_length | times: 0.58
-%}

<footer class="footer">
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__top">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <p class="footer__block-title">{{ block.settings.heading | escape }}</p>
                {%- endif -%}
                {%- assign footer_menu = block.settings.menu -%}
                {%- if footer_menu.links.size > 0 -%}
                  <ul class="footer__links">
                    {%- for link in footer_menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <p class="footer__block-title">{{ block.settings.heading | escape }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte text-small">{{ block.settings.text }}</div>
                {%- endif -%}

              {%- when 'social' -%}
                {%- if block.settings.heading != blank -%}
                  <p class="footer__block-title">{{ block.settings.heading | escape }}</p>
                {%- endif -%}
                {% render 'social-links' %}

              {%- when 'policies' -%}
                {%- if block.settings.heading != blank -%}
                  <p class="footer__block-title">{{ block.settings.heading | escape }}</p>
                {%- endif -%}
                <ul class="footer__links">
                  {%- for policy in shop.policies -%}
                    {%- if policy != blank -%}
                      <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_wordmark -%}
    <div class="page-width" style="overflow: hidden;">
      <div
        class="footer__wordmark"
        data-wordmark
        data-reveal
        aria-hidden="true"
        style="font-size: calc((min(100vw, var(--page-width)) - (var(--gutter) * 2)) / {{ wordmark_divisor }});"
      >
        <span class="footer__wordmark-inner" data-wordmark-inner>{{ wordmark | escape }}</span>
      </div>
    </div>
  {%- endif -%}

  <div class="page-width">
    <div class="footer__bottom">
      <div>
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
        {%- if section.settings.show_powered_by -%}
          <span>&nbsp;·&nbsp;{{ powered_by_link }}</span>
        {%- endif -%}
      </div>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__payment">
          <span class="visually-hidden">{{ 'sections.cart.checkout' | t }}</span>
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "tag": "div",
  "class": "footer-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Mostrar el nombre de la tienda en tipografía gigante",
      "default": true
    },
    {
      "type": "text",
      "id": "wordmark_text",
      "label": "Texto del nombre gigante",
      "info": "Si lo dejas vacío se usa el nombre de la tienda."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Mostrar métodos de pago",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Mostrar «Con tecnología de Shopify»",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menú",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Tienda"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menú",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Contacto"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Escríbenos y te respondemos el mismo día hábil.</p>"
        }
      ]
    },
    {
      "type": "social",
      "name": "Redes sociales",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Síguenos"
        }
      ]
    },
    {
      "type": "policies",
      "name": "Políticas de la tienda",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Legal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pie de página",
      "blocks": [
        { "type": "menu" },
        { "type": "policies" },
        { "type": "text" },
        { "type": "social" }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
