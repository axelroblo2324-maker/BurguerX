{%- doc -%}
  Barra de progreso hacia el envío gratis.

  Se renderiza dentro de 'cart-summary', así que aparece tanto en el carrito
  lateral como en la página de carrito, y se actualiza sola cuando Shopify
  vuelve a renderizar la sección al cambiar el carrito.

  El umbral sale de la configuración del tema; si no está definida se usa el
  valor de la tarifa de envío real de la tienda (1050 MXN) como respaldo.
{%- enddoc -%}

{%- liquid
  assign threshold_pesos = settings.levelup_free_shipping_threshold | default: 1050 | plus: 0
  assign threshold = threshold_pesos | times: 100
  assign current = cart.total_price
-%}

{%- if threshold > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign remaining = threshold | minus: current
    if remaining < 0
      assign remaining = 0
    endif

    assign percent = current | times: 100 | divided_by: threshold
    if percent > 100
      assign percent = 100
    endif

    assign remaining_money = remaining | money
  -%}

  <div
    class="lu-ship"
    role="status"
    aria-live="polite"
  >
    <p class="lu-ship__label">
      {%- if remaining > 0 -%}
        Te faltan <strong>{{ remaining_money }}</strong> para el envío gratis
      {%- else -%}
        <strong>¡Listo! Tu envío es gratis</strong>
      {%- endif -%}
    </p>

    <div class="lu-ship__track">
      <div
        class="lu-ship__fill{% if remaining == 0 %} lu-ship__fill--complete{% endif %}"
        style="width: {{ percent }}%;"
      ></div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .lu-ship {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
    padding-block-end: var(--padding-sm);
  }

  .lu-ship__label {
    margin: 0;
    font-size: var(--font-size--xs);
    line-height: 1.35;
    color: var(--color-foreground);
  }

  .lu-ship__track {
    position: relative;
    width: 100%;
    height: 3px;
    overflow: hidden;
    background-color: rgb(var(--color-foreground-rgb) / 0.14);
  }

  .lu-ship__fill {
    height: 100%;
    background-color: var(--color-foreground);
    transition: width 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .lu-ship__fill {
      transition: none;
    }
  }
{% endstylesheet %}
