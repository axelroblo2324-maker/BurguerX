{{ 'home.css' | asset_url | stylesheet_tag }}

<div
  class="section {% if section.settings.background == 'warm' %}section--warm{% endif %}"
  style="--section-padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="editorial-header">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="editorial-header__title" data-reveal style="--reveal-delay: 60ms;">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
        </div>
        {%- if section.settings.description != blank -%}
          <div class="editorial-header__aside">
            <p class="text-small text-muted" data-reveal style="--reveal-delay: 120ms;">
              {{ section.settings.description | escape }}
            </p>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="lookbook">
      {%- for block in section.blocks -%}
        {%- liquid
          assign span = block.settings.width
          assign start = block.settings.start_column
          assign offset = block.settings.offset_top
          assign span_mobile = block.settings.width_mobile

          assign start_value = 'auto'
          if start > 0
            assign start_value = start
          endif

          assign span_vw = span | times: 8
          assign img_sizes = '(min-width: 750px) ' | append: span_vw | append: 'vw, 46vw'
        -%}

        <div
          class="lookbook__item"
          style="--span: {{ span }}; --start: {{ start_value }}; --offset-top: {{ offset }}px; --span-mobile: {{ span_mobile }};"
          {{ block.shopify_attributes }}
        >
          {%- case block.type -%}
            {%- when 'product' -%}
              {%- assign block_product = block.settings.product -%}
              {%- if block_product != blank -%}
                {% render 'product-card',
                  product: block_product,
                  image_loading: 'lazy',
                  image_ratio: block.settings.image_ratio,
                  sizes: img_sizes
                %}
              {%- else -%}
                <div class="product-card">
                  <div class="product-card__media media media--tall">
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                  <div class="product-card__info">
                    <h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
                  </div>
                </div>
              {%- endif -%}

            {%- when 'image' -%}
              <div data-reveal>
                {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
                <div class="media media--{{ block.settings.image_ratio }} {% if settings.animations_image_zoom %}media-zoom{% endif %}">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 2000
                      | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800, 1100, 1500, 2000',
                        sizes: img_sizes,
                        alt: block.settings.image.alt
                    }}
                  {%- else -%}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                {%- if block.settings.caption != blank -%}
                  <div class="lookbook__caption">
                    <span class="lookbook__caption-title">{{ block.settings.caption | escape }}</span>
                  </div>
                {%- endif -%}
                {%- if block.settings.link != blank -%}</a>{%- endif -%}
              </div>

            {%- when 'text' -%}
              <div class="lookbook__text" data-reveal>
                {%- if block.settings.eyebrow != blank -%}
                  <p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h3>{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte text-small text-muted">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.button_link }}" class="link-underline">
                    {{ block.settings.button_label | escape }}
                  </a>
                {%- endif -%}
              </div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Colección asimétrica",
  "tag": "section",
  "class": "section-lookbook",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Cada bloque elige su ancho, su columna de inicio y su desfase vertical. Mezcla fotografías de prenda sola y con modelo para lograr el ritmo editorial."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta pequeña",
      "default": "Colección"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Texto editorial"
    },
    {
      "type": "header",
