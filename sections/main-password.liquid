<div class="section" style="--section-padding-block: 80px 80px; min-height: 100svh; display: grid; align-content: center;">
  <div class="page-width">
    <div style="display: grid; gap: 2rem; justify-items: center; text-align: center; max-width: 620px; margin-inline: auto;">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag: loading: 'eager', widths: '200, 400, 600', sizes: '220px', alt: shop.name
        }}
      {%- else -%}
        <p class="h0">{{ shop.name }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <p class="eyebrow">{{ section.settings.heading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- form 'storefront_password', class: 'newsletter__form', style: 'justify-content: center;' -%}
        {%- if form.errors -%}
          <p class="form-status form-status--error" role="alert">
            {{ 'password_page.login_form_error' | t }}
          </p>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="PasswordInput">
            {{ 'password_page.login_form_password_label' | t }}
          </label>
          <input
            class="field__input"
            id="PasswordInput"
            type="password"
            name="password"
            autocomplete="current-password"
            placeholder="{{ 'password_page.login_form_password_placeholder' | t | escape }}"
          >
        </div>
        <button type="submit" class="button button--compact">
          {{ 'password_page.login_form_submit' | t }}
        </button>
      {%- endform -%}

      <p class="text-small text-muted">{{ 'password_page.admin_link_html' | t }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Página de contraseña",
  "tag": "section",
  "class": "section-password",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logotipo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Etiqueta",
      "default": "Muy pronto"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Estamos preparando el próximo lanzamiento.</p>"
    }
  ]
}
{% endschema %}
