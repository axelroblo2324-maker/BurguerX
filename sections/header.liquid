{%- liquid
  assign menu = section.settings.menu
  assign has_logo = false
  if settings.logo != blank
    assign has_logo = true
  endif
-%}

<div
  class="header-wrapper"
  data-header-wrapper
  {% if section.settings.enable_transparent %}data-allow-transparent{% endif %}
  {% if section.settings.hide_on_scroll %}data-hide-on-scroll{% endif %}
>
  <header class="header">
    <div class="header__heading">
      <button
        type="button"
        class="icon-button header__menu-toggle large-hide"
        data-panel-trigger="MenuDrawer"
        aria-controls="MenuDrawer"
        aria-expanded="false"
        aria-label="{{ 'accessibility.menu' | t }}"
      >
        {% render 'icon', icon: 'menu', size: 20 %}
      </button>

      {%- if request.page_type == 'index' -%}
        <h1 class="header__logo-wrapper">
      {%- else -%}
        <div class="header__logo-wrapper">
      {%- endif -%}
        <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name | escape }}">
          {%- if has_logo -%}
            {%- assign logo_alt = settings.logo.alt | default: shop.name -%}
            <span class="header__logo-dark">
              {{
                settings.logo
                | image_url: width: 600
                | image_tag:
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '130, 260, 390, 600',
                  sizes: '(min-width: 990px) 200px, 42vw',
                  alt: logo_alt
              }}
            </span>
            {%- if settings.logo_light != blank -%}
              <span class="header__logo-light">
                {{
                  settings.logo_light
                  | image_url: width: 600
                  | image_tag:
                    loading: 'eager',
                    widths: '130, 260, 390, 600',
                    sizes: '(min-width: 990px) 200px, 42vw',
                    alt: logo_alt
                }}
              </span>
            {%- endif -%}
          {%- else -%}
            <span class="header__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- else -%}
        </div>
      {%- endif -%}
    </div>

    <nav class="header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="header__menu">
        {%- for link in menu.links -%}
          <li class="header__menu-item">
            {%- if link.links.size > 0 -%}
              <a
                href="{{ link.url }}"
                class="header__menu-link"
                {% if link.current %}aria-current="page"{% endif %}
                aria-haspopup="true"
              >
                {{ link.title | escape }}
              </a>
              <div class="header__submenu">
                {%- for child in link.links -%}
                  <a href="{{ child.url }}" {% if child.current %}aria-current="page"{% endif %}>
                    {{ child.title | escape }}
                  </a>
                {%- endfor -%}
              </div>
            {%- else -%}
              <a
                href="{{ link.url }}"
                class="header__menu-link"
                {% if link.current %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__actions">
      <button
        type="button"
        class="icon-button"
        data-panel-trigger="SearchPanel"
        aria-controls="SearchPanel"
        aria-expanded="false"
        aria-label="{{ 'general.search.search' | t }}"
      >
        {% render 'icon', icon: 'search', size: 19 %}
      </button>

      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{{ routes.account_url }}"
          class="icon-button header__icon-desktop"
          aria-label="{{ 'accessibility.account' | t }}"
        >
          {% render 'icon', icon: 'account', size: 19 %}
        </a>
      {%- endif -%}

      <a
        href="{{ routes.cart_url }}"
        class="icon-button"
        data-cart-icon
        {% if settings.cart_type == 'drawer' %}
          data-panel-trigger="CartDrawer"
          aria-controls="CartDrawer"
        {% endif %}
        aria-label="{{ 'accessibility.cart' | t }}"
      >
        {% render 'icon', icon: 'cart', size: 19 %}
        <span id="cart-icon-bubble">{% render 'cart-icon-bubble' %}</span>
      </a>
    </div>
  </header>
</div>

{% render 'menu-drawer',
  menu: menu,
  show_account: section.settings.drawer_show_account,
  show_social: section.settings.drawer_show_social
%}
{% render 'search-panel' %}

{% schema %}
{
  "name": "Encabezado",
  "tag": "div",
  "class": "header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent",
      "label": "Encabezado transparente sobre la portada",
      "info": "Se activa cuando la primera sección de la página tiene la opción de portada a pantalla completa.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_on_scroll",
      "label": "Ocultar el encabezado al bajar",
      "default": false
    },
    {
      "type": "header",
      "content": "Menú de celular"
    },
    {
      "type": "checkbox",
      "id": "drawer_show_account",
      "label": "Mostrar enlace de cuenta",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "drawer_show_social",
      "label": "Mostrar redes sociales",
      "default": true
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
