{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Encabezado editorial de colección: sin banner ni imagen de portada. Un rótulo
  fijo, el nombre de la colección y, sólo si existe, su descripción. Debajo de
  esta sección van los filtros y el ordenamiento.
{%- endcomment -%}

<div class="page-width">
  <div class="collection-hero">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ collection.title | escape }}</span>
      </nav>
    {%- endif -%}

    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow collection-hero__eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h1 class="collection-hero__title" data-reveal-words>{{- collection.title | escape -}}</h1>

    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="collection-hero__description rte" data-reveal style="--reveal-delay: 120ms;">
        {{ collection.description }}
      </div>
    {%- endif -%}

    {%- if section.settings.show_product_count -%}
      <p class="collection-hero__meta">
        {{- 'products.facets.product_count_simple' | t: count: collection.products_count -}}
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Encabezado de colección",
  "tag": "section",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Rótulo pequeño",
      "info": "Aparece encima del nombre de la colección.",
      "default": "LevelUP / Colección"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Mostrar la descripción",
      "info": "Sólo se muestra si la colección tiene descripción.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Mostrar el número de productos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Mostrar ruta de navegación",
      "default": true
    }
  ]
}
{% endschema %}
