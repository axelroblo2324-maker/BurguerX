{%- comment -%}
  Renderiza un icono en línea.
  Uso: {% render 'icon', icon: 'cart' %}
  Parámetros opcionales: class, size
{%- endcomment -%}

{%- liquid
  assign icon_class = 'icon icon-' | append: icon
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif
  assign icon_size = size | default: 18
-%}

{%- case icon -%}
  {%- when 'menu' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 7h18M3 17h18"/></svg>
  {%- when 'close' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19"/></svg>
  {%- when 'search' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/></svg>
  {%- when 'account' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8.5" r="4"/><path d="M4.5 20.5c1.4-3.7 4.2-5.5 7.5-5.5s6.1 1.8 7.5 5.5"/></svg>
  {%- when 'cart' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 7h14l-1.2 13H6.2L5 7z"/><path d="M9 7V5.6A3 3 0 0 1 12 3a3 3 0 0 1 3 2.6V7"/></svg>
  {%- when 'chevron-down' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 9l7 7 7-7"/></svg>
  {%- when 'chevron-up' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 15l7-7 7 7"/></svg>
  {%- when 'chevron-left' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg>
  {%- when 'chevron-right' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg>
  {%- when 'arrow-right' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
  {%- when 'arrow-left' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 12H4M10 6l-6 6 6 6"/></svg>
  {%- when 'plus' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14"/></svg>
  {%- when 'plus-toggle' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path class="icon--plus-v" d="M12 5v14"/></svg>
  {%- when 'filter' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h18M6 12h12M10 18h4"/></svg>
  {%- when 'check' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7"/></svg>
  {%- when 'play' -%}
    <svg class="{{ icon_class }} icon--filled" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5v13l11-6.5-11-6.5z"/></svg>
  {%- when 'pause' -%}
    <svg class="{{ icon_class }} icon--filled" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5h3v14H8zM13 5h3v14h-3z"/></svg>
  {%- when 'instagram' -%}
    <svg class="{{ icon_class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="0.9" fill="currentColor" stroke="none"/></svg>
  {%- when 'tiktok' -%}
    <svg class="{{ icon_class }} icon--filled" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16.5 3h-2.6v12.1a2.4 2.4 0 1 1-2-2.36V10.1a5.3 5.3 0 1 0 4.6 5.25V9.2a6.3 6.3 0 0 0 3.4 1V7.6a3.7 3.7 0 0 1-3.4-3.6V3z"/></svg>
  {%- when 'facebook' -%}
    <svg class="{{ icon_class }} icon--filled" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.6c-.3 0-1.3-.1-2.45-.1-2.42 0-4.08 1.48-4.08 4.2V9.9H7.5V13h2.67v8h3.33z"/></svg>
  {%- when 'youtube' -%}
    <svg class="{{ icon_class }} icon--filled" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21.6 7.9a2.5 2.5 0 0 0-1.76-1.77C18.25 5.7 12 5.7 12 5.7s-6.25 0-7.84.43A2.5 2.5 0 0 0 2.4 7.9 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.1 2.5 2.5 0 0 0 1.76 1.77c1.59.43 7.84.43 7.84.43s6.25 0 7.84-.43a2.5 2.5 0 0 0 1.76-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.1zM10 15.1V8.9l5.2 3.1-5.2 3.1z"/></svg>
  {%- when 'pinterest' -%}
    <svg class="{{ icon_class }} icon--filled" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2a10 10 0 0 0-3.65 19.31c-.09-.79-.17-2 .03-2.86.19-.79 1.2-5.05 1.2-5.05s-.3-.61-.3-1.52c0-1.42.82-2.48 1.85-2.48.87 0 1.3.66 1.3 1.45 0 .88-.57 2.2-.86 3.42-.24 1.02.51 1.86 1.52 1.86 1.83 0 3.23-1.93 3.23-4.71 0-2.46-1.77-4.18-4.3-4.18-2.93 0-4.65 2.19-4.65 4.46 0 .88.34 1.83.76 2.35.09.1.1.19.07.3l-.28 1.15c-.05.18-.15.22-.34.13-1.25-.58-2.03-2.4-2.03-3.87 0-3.15 2.29-6.04 6.6-6.04 3.46 0 6.16 2.47 6.16 5.77 0 3.44-2.17 6.21-5.18 6.21-1.01 0-1.96-.53-2.29-1.15l-.62 2.37c-.22.87-.83 1.96-1.24 2.62A10 10 0 1 0 12 2z"/></svg>
  {%- when 'x' -%}
    <svg class="{{ icon_class }} icon--filled" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.53 3H20.4l-6.27 7.17L21.5 21h-5.78l-4.52-5.92L5.82 21H2.95l6.7-7.66L2.5 3h5.93l4.09 5.41L17.53 3zm-1.01 16.28h1.59L7.56 4.63H5.85l10.67 14.65z"/></svg>
  {%- else -%}
{%- endcase -%}
