{{ 'collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign terms = search.terms | default: ''
  assign search_url = routes.search_url | append: '?q=' | append: terms | url_param_escape
  assign show_facets = false
  if search.performed and search.filters.size > 0 and section.settings.enable_filtering
    assign show_facets = true
  endif
-%}

<div class="page-width">
  <div class="search-results__header">
    <h1 class="collection-hero__title">{{ 'general.search.heading' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page-form">
      <label class="visually-hidden" for="MainSearchInput">{{ 'general.search.heading' | t }}</label>
      {% render 'icon', icon: 'search', size: 18 %}
      <input
        id="MainSearchInput"
        type="search"
        name="q"
        value="{{ terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t | escape }}"
        autocomplete="off"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="link-underline">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      <p class="collection-hero__meta">
        {{- 'general.search.results_count' | t: count: search.results_count -}}
      </p>
    {%- endif -%}
  </div>
</div>

{%- if search.performed -%}
  {%- if show_facets or section.settings.enable_sorting -%}
    {% render 'facets',
      results: search,
      results_url: search_url,
      enable_filtering: show_facets,
      enable_sorting: section.settings.enable_sorting,
      section_id: section.id,
      product_count: search.results_count
    %}
  {%- endif -%}

  {% paginate search.results by section.settings.results_per_page %}
    <div
      class="section section--flush-top"
      style="--section-padding-block: 0 {{ section.settings.padding_bottom }}px;"
    >
      <div class="page-width">
        <div class="collection-results" data-facets-results>
          {%- if search.results.size > 0 -%}
            <ul
              class="collection-grid"
              data-collection-grid
              style="--grid-columns: {{ section.settings.columns_desktop }}; --grid-columns-tablet: 3; --grid-columns-mobile: 2;"
            >
              {%- for item in search.results -%}
                <li>
                  {%- case item.object_type -%}
                    {%- when 'product' -%}
                      {% render 'product-card',
                        product: item,
                        image_loading: 'lazy',
                        sizes: '(min-width: 990px) 24vw, (min-width: 750px) 32vw, 46vw'
                      %}
                    {%- when 'article' -%}
                      <article class="article-card">
                        <a href="{{ item.url }}" class="article-card__media">
                          {%- if item.image -%}
                            {{
                              item.image
                              | image_url: width: 900
                              | image_tag: loading: 'lazy', widths: '300, 500, 700, 900', sizes: '(min-width: 990px) 24vw, 46vw', alt: item.image.alt
                            }}
                          {%- endif -%}
                        </a>
                        <h3 class="article-card__title">
                          <a href="{{ item.url }}">{{ item.title | escape }}</a>
                        </h3>
                      </article>
                    {%- when 'page' -%}
                      <div>
                        <p class="article-card__meta">{{ 'general.search.pages' | t }}</p>
                        <h3 class="article-card__title">
                          <a href="{{ item.url }}">{{ item.title | escape }}</a>
                        </h3>
                      </div>
                  {%- endcase -%}
                </li>
              {%- endfor -%}
            </ul>

            {% render 'pagination', paginate: paginate %}
          {%- else -%}
            <div class="empty-state">
              <p class="h3">{{ 'general.search.no_results' | t: terms: terms }}</p>
              <a href="{{ routes.all_products_collection_url }}" class="button button--compact button--outline">
                {{ 'general.view_all' | t }}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {% endpaginate %}
{%- endif -%}

{% schema %}
{
  "name": "Resultados de búsqueda",
  "tag": "section",
  "class": "section-main-search",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Resultados por página",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columnas en escritorio",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Activar filtros",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Activar ordenamiento",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    }
  ]
}
{% endschema %}
