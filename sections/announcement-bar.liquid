{%- liquid
  assign messages = section.blocks | where: 'type', 'message'
-%}

{%- if messages.size > 0 -%}
  <announcement-bar
    class="announcement"
    data-interval="{{ section.settings.autorotate_speed | times: 1000 }}"
    style="--announcement-bg: {{ section.settings.background }}; --announcement-fg: {{ section.settings.text_color }}; --announcement-height: {{ section.settings.height }}px;"
  >
    <div class="announcement__inner">
      {%- if messages.size > 1 and section.settings.show_arrows -%}
        <div class="announcement__nav">
          <button type="button" data-announcement-prev aria-label="{{ 'accessibility.previous' | t }}">
            {% render 'icon', icon: 'chevron-left' %}
          </button>
        </div>
      {%- endif -%}

      <div class="announcement__viewport" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
        {%- for block in messages -%}
          <div
            class="announcement__item{% if forloop.first %} is-active{% endif %}"
            data-announcement-item
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              <span>{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if messages.size > 1 and section.settings.show_arrows -%}
        <div class="announcement__nav">
          <button type="button" data-announcement-next aria-label="{{ 'accessibility.next' | t }}">
            {% render 'icon', icon: 'chevron-right' %}
          </button>
        </div>
      {%- endif -%}
    </div>
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "tag": "aside",
  "class": "announcement-section",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Color de fondo",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Alto de la barra",
      "min": 24,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "autorotate_speed",
      "label": "Segundos entre mensajes",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostrar flechas cuando hay varios mensajes",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensaje",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Envío gratis en pedidos mayores a $1,500 MXN"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de anuncios",
      "blocks": [
        { "type": "message" }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
