        { "value": "default", "label": "Blanco" },
        { "value": "warm", "label": "Blanco cálido" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 140
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Producto",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Producto"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Proporción de imagen",
          "options": [
            { "value": "adapt", "label": "Adaptar a la imagen" },
            { "value": "portrait", "label": "Vertical 3:4" },
            { "value": "tall", "label": "Vertical alta 2:3" },
            { "value": "square", "label": "Cuadrada 1:1" }
