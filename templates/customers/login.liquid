<div class="page-width">
  <div class="customer">
    <h1 class="h2">{{ 'customer.login_page.title' | t }}</h1>

    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="field">
        <label class="field__label" for="CustomerEmail">{{ 'customer.login_page.email' | t }}</label>
        <input
          class="field__input"
          id="CustomerEmail"
          type="email"
          name="customer[email]"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
        >
      </div>

      {%- if form.password_needed -%}
        <div class="field">
          <label class="field__label" for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label>
          <input
            class="field__input"
            id="CustomerPassword"
            type="password"
            name="customer[password]"
            autocomplete="current-password"
            required
          >
        </div>
      {%- endif -%}

      <button type="submit" class="button button--full">{{ 'customer.login_page.sign_in' | t }}</button>

      <div style="display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
        <a href="{{ routes.account_recover_url }}" class="link-underline">
          {{ 'customer.login_page.forgot_password' | t }}
        </a>
        <a href="{{ routes.account_register_url }}" class="link-underline">
          {{ 'customer.login_page.create_account' | t }}
        </a>
      </div>
    {%- endform -%}

    <div id="recover" style="border-top: 1px solid var(--color-border); padding-top: 1.5rem;">
      <h2 class="h4">{{ 'customer.recover_password.title' | t }}</h2>
      <p class="text-small text-muted">{{ 'customer.recover_password.subtext' | t }}</p>

      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-status">{{ 'customer.recover_password.success' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="errors">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
          <input
            class="field__input"
            id="RecoverEmail"
            type="email"
            name="email"
            autocomplete="email"
            required
          >
        </div>

        <button type="submit" class="button button--full button--outline">
          {{ 'customer.recover_password.submit' | t }}
        </button>
      {%- endform -%}
    </div>

    {%- if shop.checkout.guest_login -%}
      <div style="border-top: 1px solid var(--color-border); padding-top: 1.5rem;">
        <h2 class="h4">{{ 'customer.login_page.guest_title' | t }}</h2>
        {%- form 'guest_login' -%}
          <button type="submit" class="button button--full button--outline">
            {{ 'customer.login_page.guest_continue' | t }}
          </button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</div>
