          "max": 12,
          "step": 1,
          "default": 4
        },
        {
          "type": "range",
          "id": "start_column",
          "label": "Columna de inicio",
          "info": "0 = automático.",
          "min": 0,
          "max": 12,
          "step": 1,
          "default": 0
        },
        {
          "type": "range",
          "id": "offset_top",
          "label": "Desfase vertical",
          "min": 0,
          "max": 320,
          "step": 10,
          "unit": "px",
          "default": 0
        },
        {
          "type": "select",
          "id": "width_mobile",
          "label": "Ancho en celular",
          "info": "Sobre una rejilla de 2 columnas.",
          "options": [
            { "value": "1", "label": "Media fila" },
            { "value": "2", "label": "Fila completa" }
          ],
          "default": "1"
        }
      ]
    },
    {
